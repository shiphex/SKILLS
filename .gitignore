# 根目录的操作系统临时文件
/.DS_Store
/Thumbs.db
/Desktop.ini

# 根目录的本地工作文件；不递归忽略技能中的配套资源
/tmp/
/temp/
/.cache/
/logs/
/*.log
/*.tmp
/*.swp
/*~

# 本地私密配置与 Agent 会话；技能内容另行检查敏感信息
/.env
/.env.*
!/.env.example
/.codex/
/.claude/
/.pi/
/.superpowers/

# 不归档源项目的 Git 元数据
skills/**/.git

# 技能运行生成缓存，不属于技能包归档内容
skills/**/__pycache__/
skills/**/*.pyc
